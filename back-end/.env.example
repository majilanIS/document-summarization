# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Google Gemini (https://aistudio.google.com/apikey). Without it, the app
# uses the local Hugging Face models for summaries and chat.
GEMINI_API_KEY=

# Optional settings (defaults shown):
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.5-flash
# GEMINI_THINKING_LEVEL=low
# CHAT_ENGINE=auto
# RLHF_CANDIDATES=3
# DATABASE_PATH=data/app.db
# ALLOWED_ORIGINS=http://localhost:3000
